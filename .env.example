# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# --- Вариант 1: Yandex Cloud (YandexGPT Lite + эмбеддинги text-search) ---
# Если оба значения заданы, используются они, а настройки LLM_* / EMBED_* ниже игнорируются.
# YC_API_KEY: API-ключ сервисного аккаунта с ролью ai.languageModels.user
# YC_FOLDER_ID: id каталога в консоли Yandex Cloud
YC_API_KEY=
YC_FOLDER_ID=

# --- Вариант 2: любой OpenAI-совместимый API (по умолчанию локальная Ollama на хост-машине) ---
# ollama pull qwen3:4b-instruct-2507-q4_K_M && ollama pull bge-m3
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_PROJECT=

# Эмбеддинги (по умолчанию тот же сервер, что и LLM)
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
# Отдельная модель для эмбеддинга запросов, если у провайдера она есть
EMBED_QUERY_MODEL=

# Поиск
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.45
