# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# LLM: любой OpenAI-совместимый API.
# По умолчанию локальная Ollama на хост-машине (ollama pull qwen3:4b-instruct-2507-q4_K_M && ollama pull bge-m3)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Эмбеддинги (по умолчанию тот же сервер, что и LLM)
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3

# Поиск
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.45
